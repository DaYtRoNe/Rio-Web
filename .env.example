# Copy to .env.local and fill in from Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Optional. Only used to create/delete admin accounts from /admin/users.
# Bypasses Row Level Security — never prefix with NEXT_PUBLIC_, never commit.
# Supabase dashboard -> Project Settings -> API Keys -> Secret (service_role)
SUPABASE_SERVICE_ROLE_KEY=
